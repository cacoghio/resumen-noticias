<title>Radar IA Consola</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&family=Martian+Mono:wdth,wght@75..112,300..700&display=swap">
<style>
  /* Layout: consola de control. Barra de estado fija; en escritorio, pantalla de radar fija a la izquierda y "fichas de vuelo" a la derecha; en celular todo apilado. */
  :root {
    --fondo: #0b1417;
    --panel: #101d21;
    --panel-2: #152629;
    --linea: #213a3f;
    --texto: #e6efed;
    --texto-2: #8ea7a3;
    --fosforo: #9fe3d8;
    --ambar: #ffb547;
    --lila: #b7a8ff;
    --cc: var(--ambar);
    --an: var(--fosforo);
    --cp: var(--lila);
    --sobre-acento: #0b1417;
    --f-texto: "Instrument Sans", "Segoe UI", system-ui, sans-serif;
    --f-mono: "Martian Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --fondo: #edf2f1; --panel: #ffffff; --panel-2: #e4ecea; --linea: #c6d5d2; --texto: #0d1c1f; --texto-2: #4b6461;
      --fosforo: #0b7a6c; --ambar: #a35e00; --lila: #5a45c6; --sobre-acento: #ffffff; color-scheme: light;
    }
  }
  :root[data-theme="light"] {
    --fondo: #edf2f1; --panel: #ffffff; --panel-2: #e4ecea; --linea: #c6d5d2; --texto: #0d1c1f; --texto-2: #4b6461;
    --fosforo: #0b7a6c; --ambar: #a35e00; --lila: #5a45c6; --sobre-acento: #ffffff; color-scheme: light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--fondo); color: var(--texto); font-family: var(--f-texto); font-size: 1rem; line-height: 1.55; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--ambar); outline-offset: 2px; }
  .mono { font-family: var(--f-mono); font-stretch: 80%; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; font-variant-numeric: tabular-nums; }

  .estado { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 6; background: var(--fondo); border-bottom: 1px solid var(--linea); }
  .estado .fila { max-width: 1240px; margin: 0 auto; padding-inline: 16px; padding-block: 10px; display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; color: var(--texto-2); }
  .estado .marca { color: var(--texto); font-weight: 700; letter-spacing: .12em; }
  .estado .vivo { display: inline-flex; align-items: center; gap: 6px; color: var(--fosforo); }
  .estado .vivo i { width: 7px; height: 7px; border-radius: 50%; background: var(--fosforo); box-shadow: 0 0 8px var(--fosforo); animation: late 2.4s ease-in-out infinite; }
  @keyframes late { 50% { opacity: .35; } }
  .estado b { color: var(--texto); font-weight: 600; }
  .estado .der { margin-left: auto; }

  .consola { max-width: 1240px; margin: 0 auto; padding-inline: 16px; padding-block: 20px 64px; display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) {
    .consola { grid-template-columns: 400px minmax(0, 1fr); gap: 32px; align-items: start; }
    .lateral { position: sticky; top: 56px; }
  }
  .lateral { display: grid; gap: 16px; }
  .pantalla { background: var(--panel); border: 1px solid var(--linea); border-radius: 10px; padding: 14px; }
  .pantalla .cab { display: flex; justify-content: space-between; color: var(--texto-2); margin-bottom: 6px; }
  .pantalla svg { width: 100%; height: auto; display: block; }
  .anillo { fill: none; stroke: var(--fosforo); stroke-opacity: .22; stroke-width: 1; }
  .anillo.ext { stroke-opacity: .5; }
  .cruz { stroke: var(--fosforo); stroke-opacity: .16; stroke-width: 1; }
  .tick { stroke: var(--fosforo); stroke-opacity: .45; stroke-width: 1; }
  .grado { font-family: var(--f-mono); font-size: 7px; fill: var(--texto-2); text-anchor: middle; }
  .sector { font-family: var(--f-mono); font-size: 10px; font-weight: 700; text-anchor: middle; letter-spacing: .08em; }
  .sector.claude_code { fill: var(--cc); } .sector.anthropic { fill: var(--an); } .sector.competencia { fill: var(--cp); }
  .blip circle.nucleo { stroke: var(--panel); stroke-width: 1.5; }
  .blip.claude_code circle { fill: var(--cc); } .blip.anthropic circle { fill: var(--an); } .blip.competencia circle { fill: var(--cp); }
  .blip circle.halo { opacity: .18; }
  .blip text { font-family: var(--f-mono); font-size: 8px; fill: var(--texto); }
  .blip:hover circle.halo, .blip:focus-visible circle.halo { opacity: .45; }
  .leyenda { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 8px; color: var(--texto-2); }
  .leyenda span { display: inline-flex; gap: 6px; align-items: center; }
  .leyenda i { width: 8px; height: 8px; border-radius: 50%; display: block; }

  .lectura { background: var(--panel); border: 1px solid var(--linea); border-radius: 10px; padding: 16px; }
  .lectura h2 { margin: 0 0 10px; color: var(--fosforo); }
  .lectura ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .lectura li { display: grid; grid-template-columns: auto 1fr; gap: 10px; font-size: 1.02rem; line-height: 1.45; }
  .lectura li .n { color: var(--ambar); padding-top: 3px; }
  .lectura li b { font-weight: 650; }
  .lectura li span.r { color: var(--texto-2); }

  .filtros { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
  .filtros a { text-decoration: none; border: 1px solid var(--linea); border-radius: 999px; padding: 8px 14px; min-height: 40px; display: inline-flex; align-items: center; gap: 8px; color: var(--texto-2); }
  .filtros a i { width: 8px; height: 8px; border-radius: 50%; display: block; }
  .filtros a b { color: var(--texto); font-weight: 600; }

  .grupo { display: grid; gap: 10px; scroll-margin-top: 60px; }
  .grupo h2 { margin: 18px 0 2px; display: flex; gap: 10px; align-items: center; }
  .grupo h2 .cod { padding: 2px 8px; border-radius: 4px; color: var(--sobre-acento); font-weight: 700; }
  .grupo.claude_code h2 .cod { background: var(--cc); } .grupo.anthropic h2 .cod { background: var(--an); } .grupo.competencia h2 .cod { background: var(--cp); }
  .grupo h2 .t { font-family: var(--f-texto); font-size: 1.05rem; font-weight: 600; text-transform: none; letter-spacing: 0; }

  details.ficha { background: var(--panel); border: 1px solid var(--linea); border-radius: 10px; overflow: hidden; scroll-margin-top: 64px; }
  details.ficha[open] { border-color: var(--texto-2); }
  details.ficha summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 54px minmax(0, 1fr); }
  details.ficha summary::-webkit-details-marker { display: none; }
  .franja { display: grid; align-content: space-between; justify-items: center; padding: 12px 0; color: var(--sobre-acento); font-weight: 700; }
  .claude_code .franja { background: var(--cc); } .anthropic .franja { background: var(--an); } .competencia .franja { background: var(--cp); }
  .franja .num { font-size: .95rem; }
  .cuerpo { padding: 12px 16px 14px; display: grid; gap: 6px; min-width: 0; }
  .campos { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--texto-2); }
  .campos .imp { display: inline-flex; gap: 2px; align-items: center; }
  .campos .imp i { width: 5px; height: 11px; background: var(--linea); display: block; border-radius: 1px; }
  .campos .imp i.on { background: var(--ambar); }
  .campos .tipo { color: var(--texto); }
  .ficha h3 { margin: 0; font-size: clamp(1.12rem, 3.6vw, 1.32rem); line-height: 1.25; font-weight: 650; text-wrap: balance; }
  .ficha.imp3 h3 { font-size: clamp(1.25rem, 4.4vw, 1.55rem); }
  .ficha .bajada { margin: 0; color: var(--texto-2); }
  .abrir { color: var(--fosforo); }
  details[open] .abrir .c { display: none; } details:not([open]) .abrir .a { display: none; }
  .detalle { border-top: 1px dashed var(--linea); margin-left: 54px; padding: 4px 16px 16px; display: grid; gap: 4px; overflow-wrap: anywhere; }
  .detalle > * { min-width: 0; }
  @media (max-width: 600px) { .detalle { margin-left: 0; padding-inline: 14px; } .estado .fecha, .estado .utc { display: none; } }
  .detalle h4 { margin: 12px 0 0; color: var(--fosforo); }
  .detalle p { margin: 0; max-width: 68ch; }
  .terminal { margin-top: 12px; background: var(--fondo); border: 1px solid var(--linea); border-radius: 8px; padding: 12px; display: grid; gap: 8px; }
  .terminal .t { color: var(--ambar); }
  .terminal p { font-size: .95rem; color: var(--texto-2); }
  .cmd { max-width: 100%; min-width: 0; display: flex; gap: 8px; align-items: center; min-width: 0; }
  .cmd code { flex: 1; min-width: 0; font-family: var(--f-mono); font-size: .78rem; color: var(--fosforo); overflow-x: auto; white-space: nowrap; }
  .cmd code::before { content: "› "; color: var(--texto-2); }
  .copiar { font-family: var(--f-mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .06em; background: transparent; color: var(--texto); border: 1px solid var(--linea); border-radius: 6px; padding: 8px 10px; min-height: 36px; cursor: pointer; }
  .copiar:hover { border-color: var(--fosforo); color: var(--fosforo); }
  code { font-family: var(--f-mono); font-size: .8em; }
  .diff { margin-top: 10px; display: grid; gap: 8px; background: var(--panel-2); border-radius: 8px; padding: 12px; }
  .diff .cab { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; }
  .diff .ver { color: var(--ambar); font-weight: 700; }
  .diff .barra { display: flex; gap: 2px; height: 10px; }
  .diff .barra span { display: block; border-radius: 1px; }
  .k-nuevo { background: var(--ambar); } .k-mejora { background: var(--fosforo); } .k-cambio { background: var(--lila); } .k-arreglo { background: var(--texto-2); }
  .diff .ley { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--texto-2); }
  .diff .ley span { display: inline-flex; gap: 5px; align-items: center; }
  .diff .ley i { width: 8px; height: 8px; display: block; border-radius: 1px; }
  .diff ul { margin: 4px 0 0; padding-left: 1.1em; display: grid; gap: 4px; font-size: .92rem; }
  .diff li::marker { color: var(--ambar); }
  .video { display: flex; gap: 12px; align-items: center; margin-top: 10px; text-decoration: none; background: var(--panel-2); border-radius: 8px; padding: 10px; }
  .video .p { width: 88px; aspect-ratio: 16 / 9; max-width: 100%; border-radius: 4px; background: repeating-linear-gradient(0deg, rgba(159, 227, 216, .08) 0 2px, transparent 2px 4px), var(--fondo); display: grid; place-items: center; color: var(--fosforo); border: 1px solid var(--linea); }
  .fuentes { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; color: var(--texto-2); }
  .cob { display: inline-flex; gap: 2px; }
  .cob i { width: 6px; height: 6px; background: var(--fosforo); display: block; border-radius: 50%; }
  .cob i.no { background: var(--linea); }
  .fuentes a { color: var(--texto); font-size: .92rem; }
  .registro { margin-top: 28px; border: 1px solid var(--linea); border-radius: 10px; padding: 14px 16px; color: var(--texto-2); display: grid; gap: 4px; }
  .registro b { color: var(--texto); font-weight: 500; }
  .registro .ok { color: var(--fosforo); } .registro .no { color: var(--ambar); }
  .ayuda { color: var(--texto-2); margin-top: 8px; }
  @media (prefers-reduced-motion: reduce) { .estado .vivo i { animation: none; } }
</style>

<header class="estado">
  <div class="fila mono">
    <span class="marca">Radar IA</span>
    <span class="vivo"><i></i>En línea</span>
    <span class="fecha">{{ fecha_corta }}</span>
    <span><b>{{ hora }}</b> CLST<span class="utc"> · {{ hora_utc }} UTC</span></span>
    <span class="der">Ed. {{ '%03d' % edicion }} · <b>{{ total }}</b> contactos · {{ minutos }} min</span>
  </div>
</header>

<main class="consola">
  <aside class="lateral">
    <section class="lectura" aria-labelledby="t-30">
      <h2 id="t-30" class="mono">En 30 segundos</h2>
      <ol>
        {% for r in resumen_dia %}<li><span class="n mono">{{ '%02d' % loop.index }}</span><div><b>{{ r.lead }}</b> <span class="r">{{ r.resto }}</span></div></li>
        {% endfor %}
      </ol>
    </section>

    <section class="pantalla" aria-labelledby="t-scope">
      <div class="cab mono"><span id="t-scope">Pantalla · sectores</span><span>Barrido 9 s</span></div>
      <svg viewBox="-14 -14 {{ radar.tam + 28 }} {{ radar.tam + 28 }}" role="group" aria-label="Radar del día: {{ total }} contactos por sección e importancia">
        <defs>
          <radialGradient id="rastro" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate({{ radar.c }} {{ radar.c }}) scale({{ radar.r }})">
            <stop offset="0" style="stop-color: var(--fosforo)" stop-opacity=".0"/>
            <stop offset="1" style="stop-color: var(--fosforo)" stop-opacity=".22"/>
          </radialGradient>
        </defs>
        {% for a in radar.anillos %}<circle class="anillo{{ ' ext' if loop.last }}" cx="{{ radar.c }}" cy="{{ radar.c }}" r="{{ a }}"/>{% endfor %}
        <line class="cruz" x1="{{ radar.c }}" y1="{{ radar.c - radar.r }}" x2="{{ radar.c }}" y2="{{ radar.c + radar.r }}"/>
        <line class="cruz" x1="{{ radar.c - radar.r }}" y1="{{ radar.c }}" x2="{{ radar.c + radar.r }}" y2="{{ radar.c }}"/>
        {% for d in radar.divisiones %}<line class="cruz" x1="{{ radar.c }}" y1="{{ radar.c }}" x2="{{ d.x }}" y2="{{ d.y }}" stroke-dasharray="3 3"/>{% endfor %}
        {% for t in radar.ticks %}<line class="tick" x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}"/>{% if t.g % 90 == 0 %}<text class="grado" x="{{ t.tx }}" y="{{ t.ty }}">{{ '%03d' % t.g }}</text>{% endif %}{% endfor %}
        <g aria-hidden="true">
          <path d="M{{ radar.c }} {{ radar.c }} L{{ radar.c }} {{ radar.c - radar.r }} A{{ radar.r }} {{ radar.r }} 0 0 1 {{ radar.c + radar.r * 0.7071 }} {{ radar.c - radar.r * 0.7071 }} Z" fill="url(#rastro)"/>
          <line x1="{{ radar.c }}" y1="{{ radar.c }}" x2="{{ radar.c + radar.r * 0.7071 }}" y2="{{ radar.c - radar.r * 0.7071 }}" style="stroke: var(--fosforo)" stroke-width="1.5"/>
          <animateTransform attributeName="transform" type="rotate" from="0 {{ radar.c }} {{ radar.c }}" to="360 {{ radar.c }} {{ radar.c }}" dur="9s" repeatCount="indefinite"/>
        </g>
        {% for e in radar.etiquetas %}<text class="sector {{ e.seccion }}" x="{{ e.x }}" y="{{ e.y }}">{{ e.codigo }}</text>{% endfor %}
        {% for p in radar.puntos %}
        <a class="blip {{ p.seccion }}" href="#{{ p.id }}"><title>{{ p.n }}. {{ p.titular }}</title>
          <circle class="halo" cx="{{ p.x }}" cy="{{ p.y }}" r="{{ p.r + 6 }}"/><circle class="nucleo" cx="{{ p.x }}" cy="{{ p.y }}" r="{{ p.r * 0.7 }}"/>
          <text x="{{ p.x + p.r + 2 }}" y="{{ p.y - p.r + 2 }}">{{ '%02d' % p.n }}</text></a>
        {% endfor %}
      </svg>
      <div class="leyenda mono">{% for s in secciones %}<span><i style="background: var(--{{ s.codigo | lower }})"></i>{{ s.codigo }} {{ s.nombre }}</span>{% endfor %}</div>
    </section>
    <p class="ayuda mono">Atajos: J / K para moverse · Enter para abrir</p>
  </aside>

  <div>
    <nav class="filtros mono" aria-label="Secciones">
      {% for s in secciones %}<a href="#g-{{ s.clave }}"><i style="background: var(--{{ s.codigo | lower }})"></i>{{ s.nombre }} <b>{{ s.notas | length }}</b></a>{% endfor %}
    </nav>

    {% for s in secciones %}
    <section class="grupo {{ s.clave }}" id="g-{{ s.clave }}" aria-labelledby="h-{{ s.clave }}">
      <h2 id="h-{{ s.clave }}" class="mono"><span class="cod">{{ s.codigo }}</span><span class="t">{{ s.nombre }}</span></h2>
      {% for it in s.notas %}
      <details class="ficha imp{{ it.importancia }} {{ s.clave }}" id="{{ it.id }}" {{ 'open' if it.importancia == 3 }}>
        <summary>
          <span class="franja mono"><span>{{ s.codigo }}</span><span class="num">{{ '%02d' % it.n }}</span></span>
          <span class="cuerpo">
            <span class="campos mono">
              <span class="imp" title="Importancia {{ it.importancia }} de 3">IMP {% for i in range(3) %}<i class="{{ 'on' if i < it.importancia }}"></i>{% endfor %}</span>
              <span>COB {{ '%02d' % it.cobertura }}</span>
              {% if it.es_release %}<span class="tipo">Release v{{ it.version }}</span>{% endif %}
              {% if it.es_video %}<span class="tipo">Video</span>{% endif %}
              {% for p in it.personas %}<span class="tipo">Voz · {{ p }}</span>{% endfor %}
            </span>
            <h3>{{ it.titular }}</h3>
            <span class="bajada">{{ it.bajada }}</span>
            <span class="abrir mono"><span class="c">+ Ver análisis</span><span class="a">− Cerrar</span></span>
          </span>
        </summary>
        <div class="detalle">
          {% if it.es_release %}
          <div class="diff">
            <div class="cab mono"><span class="ver">v{{ it.version }}</span><span>{{ it.cambios.total }} cambios</span></div>
            <div class="barra" role="img" aria-label="{% for b in it.cambios.barras %}{{ b.n }} {{ b.nombre | lower }}{{ ', ' if not loop.last }}{% endfor %}">{% for b in it.cambios.barras %}<span class="k-{{ b.clave }}" style="width: {{ b.pct }}%"></span>{% endfor %}</div>
            <div class="ley mono">{% for b in it.cambios.barras %}<span><i class="k-{{ b.clave }}"></i>{{ b.n }} {{ b.nombre }}</span>{% endfor %}</div>
            <ul>{% for d in it.cambios.destacados %}<li>{{ d | codigo }}</li>{% endfor %}</ul>
          </div>
          {% endif %}
          {% if it.es_video %}
          <a class="video" href="{{ it.fuentes[0].link }}" rel="noopener" target="_blank"><span class="p mono" aria-hidden="true">▶</span><span><span class="mono">YouTube</span><br>{{ it.personas[0] }}</span></a>
          {% endif %}
          <h4 class="mono">Qué pasó</h4>
          <p>{{ it.que_paso }}</p>
          <h4 class="mono">Por qué importa</h4>
          <p>{{ it.por_que_importa }}</p>
          {% if it.que_probar %}
          <div class="terminal">
            <span class="t mono">Qué probar hoy</span>
            <p>{{ it.que_probar }}</p>
            {% for c in it.comandos %}<div class="cmd"><code>{{ c }}</code><button class="copiar" type="button" data-copiar="{{ c }}">Copiar</button></div>{% endfor %}
          </div>
          {% endif %}
          <div class="fuentes">
            <span class="cob" title="{{ it.cobertura }} medios">{% for i in range(10) %}<i class="{{ '' if i < it.cobertura else 'no' }}"></i>{% endfor %}</span>
            <span class="mono">{{ it.cobertura }} medio{{ 's' if it.cobertura != 1 }}</span>
            {% for f in it.fuentes[:4] %}<a href="{{ f.link }}" rel="noopener" target="_blank">{{ f.medio }}</a>{% endfor %}
          </div>
        </div>
      </details>
      {% endfor %}
    </section>
    {% endfor %}

    <section class="registro mono" aria-label="Registro de la pasada">
      <span>Registro · pasada {{ hora }} CLST</span>
      <span class="ok">✓ {{ fuentes_revisadas - fuentes_caidas | length }} fuentes en línea</span>
      <span class="no">! Sin respuesta: {{ fuentes_caidas | join(', ') }}</span>
      <span>Análisis: <b>{{ modelo }}</b> · Próxima pasada: <b>mañana 08:30</b> · <a href="#">Archivo</a></span>
    </section>
  </div>
</main>

<script>
  (function () {
    var fichas = Array.prototype.slice.call(document.querySelectorAll('details.ficha'));
    var actual = -1;
    document.addEventListener('keydown', function (e) {
      if (e.target.closest('input, textarea, [contenteditable]')) return;
      if (e.key === 'j' || e.key === 'k') {
        actual = Math.max(0, Math.min(fichas.length - 1, actual + (e.key === 'j' ? 1 : -1)));
        var s = fichas[actual].querySelector('summary');
        s.focus();
        fichas[actual].scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    });
    document.querySelectorAll('.blip').forEach(function (b) {
      b.addEventListener('click', function () {
        var d = document.getElementById(b.getAttribute('href').slice(1));
        if (d) d.open = true;
      });
    });
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('animateTransform').forEach(function (a) { a.remove(); });
    }
    document.querySelectorAll('[data-copiar]').forEach(function (b) {
      b.addEventListener('click', function () {
        var texto = b.getAttribute('data-copiar');
        function ok() { b.textContent = 'Copiado ✓'; setTimeout(function () { b.textContent = 'Copiar'; }, 1600); }
        function sel() { var r = document.createRange(); r.selectNodeContents(b.parentNode.querySelector('code')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Ctrl+C'; }
        if (navigator.clipboard) navigator.clipboard.writeText(texto).then(ok, sel); else sel();
      });
    });
  })();
</script>
