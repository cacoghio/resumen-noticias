<!doctype html>
<html lang="es-CL">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Radar IA · {{ fecha_larga }}</title>
<meta name="description" content="Radar IA del {{ fecha_larga }}{% if noticias %}: {{ noticias[0].titular }}{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --fondo: #f3efe7; --panel: #fbf8f2; --tinta: #1d1b17; --tinta-2: #5d574c; --regla: #d4cab8;
    --acento: #c4471f; --acento-suave: #f4ddd2; --codigo: #ebe4d6;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --fondo: #0f1115; --panel: #171a21; --tinta: #efe9dc; --tinta-2: #9aa0b1; --regla: #2a2f3a;
      --acento: #ec8a5f; --acento-suave: #3a231a; --codigo: #22262f;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--fondo); color: var(--tinta); font-family: "Newsreader", Georgia, serif; font-size: 1.125rem; line-height: 1.6; }
  .hoja { max-width: 760px; margin: 0 auto; padding: 0 16px 64px; background: var(--panel); min-height: 100vh; box-shadow: 0 0 0 1px var(--regla); }
  header { padding: 44px 0 22px; border-bottom: 3px double var(--tinta); }
  .sobre { font-family: "IBM Plex Mono", monospace; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); }
  h1 { font-family: "Fraunces", serif; font-weight: 800; font-size: clamp(2.6rem, 10vw, 4.4rem); line-height: .92; margin: 10px 0 8px; letter-spacing: -.03em; }
  h1 em { font-style: normal; color: var(--acento); }
  .fecha { font-style: italic; color: var(--tinta-2); margin: 0; }
  .aviso { margin: 22px 0 0; padding: 14px 16px; background: var(--acento-suave); border-left: 3px solid var(--acento); }
  nav.indice { padding: 18px 0 6px; border-bottom: 1px solid var(--regla); }
  nav.indice h2 { margin: 14px 0 4px; }
  nav.indice ul { margin: 0 0 8px; padding: 0; list-style: none; }
  nav.indice li { padding: 3px 0; line-height: 1.35; }
  nav.indice a { color: var(--tinta); text-decoration: none; }
  nav.indice a:hover { text-decoration: underline; text-decoration-color: var(--acento); }
  h2.seccion { font-family: "IBM Plex Mono", monospace; font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--acento); font-weight: 500; margin: 36px 0 0; padding-bottom: 6px; border-bottom: 2px solid var(--acento); }
  nav.indice h2 { font-family: "IBM Plex Mono", monospace; font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); font-weight: 500; }
  article { padding: 28px 0 26px; border-bottom: 1px solid var(--regla); opacity: 0; transform: translateY(8px); animation: entra .5s ease forwards; }
  @keyframes entra { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { article { animation: none; opacity: 1; transform: none; } }
  .etiquetas { display: flex; flex-wrap: wrap; gap: 8px; font-family: "IBM Plex Mono", monospace; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 4px; }
  .chip { padding: 3px 8px; background: var(--acento-suave); color: var(--acento); border-radius: 2px; }
  .chip.gris { background: transparent; color: var(--tinta-2); border: 1px solid var(--regla); }
  h3.titular { font-family: "Fraunces", serif; font-weight: 600; font-size: clamp(1.45rem, 5vw, 1.9rem); line-height: 1.14; margin: 10px 0 8px; letter-spacing: -.01em; }
  .bajada { font-style: italic; font-size: 1.15rem; color: var(--tinta-2); margin: 0 0 14px; }
  h4 { font-family: "IBM Plex Mono", monospace; font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--acento); margin: 18px 0 4px; font-weight: 500; }
  p { margin: 0 0 10px; }
  .probar { margin-top: 16px; padding: 12px 16px; background: var(--codigo); border-left: 3px solid var(--acento); }
  .probar h4 { margin-top: 0; }
  code { font-family: "IBM Plex Mono", monospace; font-size: .85em; background: var(--codigo); padding: 1px 5px; border-radius: 3px; }
  .fuentes { margin-top: 16px; font-size: .92rem; color: var(--tinta-2); }
  .fuentes a { color: var(--tinta); text-decoration: underline; text-decoration-color: var(--regla); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .fuentes a:hover { text-decoration-color: var(--acento); }
  footer { padding: 28px 0 0; font-size: .85rem; color: var(--tinta-2); text-align: center; }
  footer a { color: var(--tinta-2); }
</style>
</head>
<body>
<div class="hoja">
  <header>
    <div class="sobre">{{ fecha_larga }}</div>
    <h1>Radar <em>IA</em></h1>
    <p class="fecha">Claude Code · Anthropic · Competencia</p>
    {% if aviso %}<p class="aviso">{{ aviso }}</p>{% endif %}
  </header>

  {% if noticias %}
  <nav class="indice" aria-label="Titulares">
    {% for nombre, items in secciones %}
    <h2>{{ nombre }}</h2>
    <ul>{% for n in items %}<li><a href="#{{ n.id }}">{{ n.titular }}</a></li>{% endfor %}</ul>
    {% endfor %}
  </nav>
  {% endif %}

  {% for nombre, items in secciones %}
  <h2 class="seccion">{{ nombre }}</h2>
  {% for n in items %}
  <article id="{{ n.id }}">
    <div class="etiquetas">
      {% for e in n.etiquetas %}<span class="chip">{{ e }}</span>{% endfor %}
      {% if n.cobertura > 1 %}<span class="chip gris">{{ n.cobertura }} medios</span>{% endif %}
    </div>
    <h3 class="titular">{{ n.titular }}</h3>
    <p class="bajada">{{ n.bajada }}</p>

    <h4>Qué pasó</h4>
    <p>{{ n.que_paso }}</p>

    <h4>Por qué importa</h4>
    <p>{{ n.por_que_importa }}</p>

    {% if n.que_probar %}
    <div class="probar"><h4>Qué probar</h4><p>{{ n.que_probar | replace("`", "") }}</p></div>
    {% endif %}

    <div class="fuentes">Fuentes:
      {% for f in n.fuentes %}<a href="{{ f.link }}" rel="noopener" target="_blank">{{ f.medio }}</a>{{ ", " if not loop.last }}{% endfor %}
    </div>
  </article>
  {% endfor %}
  {% endfor %}

  <footer>
    Generado con {{ modelo }} a partir de fuentes públicas. Puede tener errores: revisa las fuentes.
    {% if url_archivo %}<br><a href="{{ url_archivo }}">Días anteriores</a>{% endif %}
  </footer>
</div>
</body>
</html>
